{
  "name": "AwesomeProject",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "fast-install-project": "cd ../ && npm i --legacy-peer-deps && npm pack && cd ./example && npm i --legacy-peer-deps",
    "fast:pkg": "npm run fast-install-project && npm run dev",
    "start": "hdc rport tcp:8081 tcp:8081 && react-native start",
    "reStart": "npm run install:pkg && npm run codegen && hdc rport tcp:8081 tcp:8081 && react-native start",
    "pack:pkg": "cd ../ && npm pack && cd ./example",
    "install:pkg": "npm uninstall @react-native-ohos/react-native-in-app-review && npm run pack:pkg && npm i @react-native-ohos/react-native-in-app-review@file:../react-native-ohos-react-native-in-app-review-4.4.3-beta.1.tgz",
    "dev": "npm run codegen && react-native bundle-harmony --dev --minify=false",
    "postinstall": "node ./scripts/create-build-profile && node ./scripts/sync-hvigor-plugin",
    "codegen": "react-native codegen-harmony --rnoh-module-path ./harmony/entry/oh_modules/@rnoh/react-native-openharmony"
  },
  "dependencies": {
    "@react-native-oh/react-native-harmony": "0.77.75",
    "react": "18.3.1",
    "react-native": "0.77.1",
    "@react-native-ohos/react-native-in-app-review": "file:../react-native-ohos-react-native-in-app-review-4.4.3-beta.1.tgz"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "15.0.1",
    "@react-native-community/cli-platform-android": "15.0.1",
    "@react-native-community/cli-platform-ios": "15.0.1",
    "@react-native-oh/react-native-harmony-cli": "0.77.75",
    "@react-native/babel-preset": "0.77.1",
    "@react-native/eslint-config": "0.77.1",
    "@react-native/metro-config": "0.77.1",
    "@tsconfig/react-native": "^3.0.0",
    "@types/react": "^18.2.6",
    "@types/react-test-renderer": "^18.0.0",
    "babel-jest": "^29.6.3",
    "eslint": "^8.19.0",
    "jest": "^29.7.0",
    "prettier": "2.8.8",
    "react-test-renderer": "18.3.1",
    "typescript": "5.5.4"
  },
  "engines": {
    "node": ">=18"
  }
}
